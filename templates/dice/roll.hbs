<div class="mds-chat-roll">
  <div class="dice-roll flexcol" data-action="expandRoll">
    {{#if roll.options.description}}
    <div class="mds-roll-desc">{{{roll.options.description}}}</div>
    {{/if}}

    {{#if flavor}}
    <div class="dice-flavor">{{flavor}}</div>
    {{/if}}

    <div class="dice-result">
      <div class="dice-formula">{{formula}}</div>
      {{{tooltip}}}

      {{#if roll.isSimpleRoll}}
        <h4 class="dice-total">{{total}}</h4>
      {{else}}
        {{#if (gt (add success roll.options.prideBonus) 0)}}
          <h4 class="dice-total mds-success">
            <i class="fa-solid fa-compass"></i>
            {{localize "MDS.Chat.Successes"}}: {{add success roll.options.prideBonus}}
            {{#if roll.options.prideBonus}}
              <span class="mds-tag">+1 {{localize "MDS.Traits.Pride"}}</span>
            {{/if}}
          </h4>
        {{else}}
          <h4 class="dice-total mds-failure">
            {{localize "MDS.Chat.Successes"}}: 0
          </h4>
        {{/if}}
      {{/if}}
    </div>
  </div>

  {{#if showInfos}}
    {{{infos}}}
  {{/if}}

  {{#if pushable}}
  <div class="dice-buttons mds-btn-row" data-owner-id="{{roll.owner}}">
    <button type="button" class="mds-btn mds-btn-primary dice-button push" data-action="pushRoll">
      <i class="fa-solid fa-rotate-right"></i> {{localize "MDS.Chat.Push"}}
    </button>
    <button type="button" class="mds-btn dice-button accept" data-action="acceptRoll">
      <i class="fa-solid fa-check"></i> {{localize "MDS.Chat.Accept"}}
    </button>
  </div>
  {{/if}}

  {{#if (and (not pushable) (gt roll.attackDamage 0))}}
  <div class="dice-buttons mds-btn-row">
    <button type="button" class="mds-btn mds-btn-danger" data-action="applyTargetDamage">
      <i class="fa-solid fa-crosshairs"></i> {{localize "MDS.Chat.ApplyDamage"}} ({{roll.attackDamage}})
    </button>
  </div>
  {{/if}}

  {{#if roll.options.triggeredBroken}}
  <div class="dice-buttons mds-btn-row">
    <button type="button" class="mds-btn mds-btn-danger" data-action="rollCritTable" data-category="{{roll.options.brokenTrack}}">
      <i class="fa-solid fa-skull"></i> {{localize "MDS.Critical.RollTable"}}
    </button>
  </div>
  {{/if}}

  {{#if roll.options.callingAtMax}}
  <div class="dice-buttons mds-btn-row">
    <button type="button" class="mds-btn mds-btn-danger" data-action="rollCallingTest">
      <i class="fa-solid fa-water"></i> {{localize "MDS.Calling.TestTitle"}}
    </button>
  </div>
  {{/if}}
</div>
